APP_NAME=ML FastAPI Service
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# For running locally on host (e.g. uvicorn main:app):
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/media_monitor
# For running inside Docker Compose (connecting to host machine's PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:root@host.docker.internal:5432/media_monitor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
NORMALIZE_EMBEDDINGS=true

CLASSIFIER_PATH=artifacts/classifier.joblib
LABEL_ENCODER_PATH=artifacts/label_encoder.pkl
ALLOW_MISSING_ARTIFACTS=true

DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=100

